---
export const prerender = true;
import { getCollection } from "astro:content";
import type { AstroSeoProps } from "@astrolib/seo";
import { DEFAULT_OG_IMAGE, SITE_URL, projectSlugFromEntrySlug } from "@/lib/seo";
import MarkdownPostLayout from "../../layouts/MarkdownPostLayout.astro";

export async function getStaticPaths() {
	const projectsEntries = await getCollection("projects");

	return projectsEntries
		.map((entry) => {
			const [lang, ...slug] = entry.slug.split("/");
			return { params: { lang, slug: slug.join("/") || undefined }, props: entry };
		})
		.filter((entry) => entry.params.lang === "en");
}

const slugParam = Astro.params.slug?.toString() ?? "";
const projectsEntries = await getCollection("projects");
const entry =
	projectsEntries.find((e) => e.slug === `en/${slugParam}`) ??
	projectsEntries.find((e) => e.slug === slugParam) ??
	projectsEntries.find((e) => e.slug.endsWith(`/${slugParam}`));
if (!entry) {
	return Astro.redirect("/404");
}
const { Content } = await entry.render();

const projectSlug = projectSlugFromEntrySlug(entry.slug);
const projectUrl = `${SITE_URL}/work/${projectSlug}/`;

const seo: AstroSeoProps = {
	title: `${entry.data.title} — Hermosa Software`,
	description: entry.data.description,
	canonical: projectUrl,
	openGraph: {
		url: projectUrl,
		title: entry.data.title,
		description: entry.data.description,
		images: [
			{
				url: DEFAULT_OG_IMAGE,
				width: 1200,
				height: 630,
				alt: entry.data.image.alt,
				type: "image/gif",
			},
		],
		site_name: "Hermosa Software",
	},
	twitter: {
		handle: "@hermosasoftware",
		site: "@hermosasoftware",
		cardType: "summary_large_image",
	},
};
---

<MarkdownPostLayout frontmatter={entry.data} body={entry.body} seo={seo}>
	<Content />
</MarkdownPostLayout>
