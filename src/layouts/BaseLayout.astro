---
import BlobCursorFollower from "@/components/global/BlobCursorFollower.astro";
import { AstroSeo, type AstroSeoProps } from "@astrolib/seo";
import BaseHead from "@components/BaseHead.astro";
import BackgroundTexture from "@components/global/BackgroundTexture.astro";
import Footer from "@components/global/Footer.astro";
import Navigation from "@components/global/Navigation.astro";
import Contact from "@/components/forms/Contact.astro";
import { DEFAULT_OG_IMAGE, SITE_URL, organizationSchema, websiteSchema } from "@/lib/seo";
import { getLangFromUrl } from "../i18n/utils";

const { pathname } = Astro.url;

type Props = {
	seo?: AstroSeoProps;
	hideContact?: boolean;
};

const { seo: seoProp, hideContact = false } = Astro.props;

const lang = getLangFromUrl(Astro.url);

const defaultSeo: AstroSeoProps = {
	title: "Hermosa Software — Web & Mobile Apps, Costa Rica",
	description:
		"Hermosa Software is a Costa Rica-based development team that ships web apps, React Native mobile apps, and staff augmentation — from concept to production.",
	canonical: SITE_URL,
	openGraph: {
		url: SITE_URL,
		title: "Hermosa Software — Web & Mobile Apps, Costa Rica",
		description:
			"Hermosa Software is a Costa Rica-based development team that ships web apps, React Native mobile apps, and staff augmentation — from concept to production.",
		images: [
			{
				url: DEFAULT_OG_IMAGE,
				width: 1200,
				height: 630,
				alt: "Hermosa Software",
				type: "image/gif",
			},
		],
		site_name: "Hermosa Software",
	},
	twitter: {
		handle: "@hermosasoftware",
		site: "@hermosasoftware",
		cardType: "summary_large_image",
	},
	additionalMetaTags: [
		{
			name: "publisher",
			content: "Hermosa Software",
		},
	],
};

const seo = {
	...defaultSeo,
	...seoProp,
};

function cursorFollowerActive() {
	const paths = ["", "/"];
	return paths.includes(pathname);
}
const isContactPage = /(?:^|\/)contact\/?$/.test(pathname);
---

<html lang={lang}>
	<head>
		<BaseHead />
		<AstroSeo {...seo} />
		<script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
		<script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
	</head>
	<body class="bg-slate-50">
		<style>html{ scroll-behavior: smooth; }</style>
		<BackgroundTexture />
		<Navigation />
		{cursorFollowerActive() && <BlobCursorFollower />}
		<slot />
	{!isContactPage && !hideContact && <Contact />}
		<Footer />
	</body>
</html>
